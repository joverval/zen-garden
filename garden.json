{
  "schemaVersion": 3,
  "id": "quiet-garden",
  "title": "The Quiet Garden",
  "designPrinciple": "The gardener performs necessary work. Nature resolves many disturbances without intervention.",
  "time": {
    "activeRealMinutesPerGardenDay": 20,
    "offlineRealHoursPerGardenDay": 24,
    "maxOfflineGardenDays": 3,
    "simulationStepGardenMinutes": 10,
    "initialClockHour": 6,
    "playbackSpeeds": [
      1,
      2,
      4
    ],
    "defaultPlaybackSpeed": 1,
    "speedAffects": [
      "active garden time",
      "weather",
      "energy regeneration",
      "bird animation and visits"
    ],
    "offlineSpeedIndependentOfPlayback": true
  },
  "audio": {
    "pondFountain": {
      "enabledByDefault": false,
      "initialVolume": 0.32,
      "type": "user-supplied-mp3-loop",
      "file": "audio/water-drops.mp3",
      "description": "User-supplied 6.384-second multi-drop recording; two looped sources maximum.",
      "layers": [
        {
          "gain": 0.82,
          "playbackRate": 1.0,
          "offsetSeconds": 0
        },
        {
          "gain": 0.16,
          "playbackRate": 0.986,
          "offsetSeconds": 2.5
        }
      ],
      "maxLayers": 2
    },
    "ambience": {
      "birds": {
        "files": [
          "audio/birds-chirping01.mp3",
          "audio/birds-chirping02.mp3",
          "audio/birds-chirping03.mp3"
        ],
        "gain": 0.25,
        "mode": "random-short-calls-only-during-live-bird-visit",
        "minSecondsBetween": 5,
        "maxSecondsBetween": 14,
        "minCueSeconds": 2.5,
        "maxCueSeconds": 5.5
      },
      "crickets": {
        "files": [
          "audio/crickets01.mp3",
          "audio/crickets02.mp3"
        ],
        "gain": 0.19,
        "mode": "random-short-night-cues",
        "minSecondsBetween": 16,
        "maxSecondsBetween": 38,
        "minCueSeconds": 4,
        "maxCueSeconds": 8
      },
      "rain": {
        "files": [
          "audio/rain01.mp3"
        ],
        "gain": 0.37,
        "mode": "loop-while-raining",
        "fadeSeconds": 2.3
      },
      "wind": {
        "files": [
          "audio/wind01.mp3",
          "audio/wind02.mp3"
        ],
        "gain": 0.28,
        "mode": "loop-only-while-windy",
        "fadeSeconds": 2.4,
        "maxLayers": 2,
        "secondLayerGainRatio": 0.3
      }
    },
    "notes": "All nature clips supplied by the user. Never play bird calls without a visible bird. Never play crickets outside the night. Wind supports no more than two simultaneous layers. Fountain maximum is two layers. Visual sprites and textures load and decode before the garden opens; decoded image references remain in memory."
  },
  "visualLimits": {
    "largeAnimals": 1,
    "smallAnimals": 3,
    "visibleLeaves": 14,
    "visibleBranches": 5,
    "visibleNuts": 8
  },
